---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/site';
---

<BaseLayout title="Page not found — Membrane">
  <Nav />
  <main id="main" class="container-page flex min-h-[70vh] flex-col items-center justify-center pt-28 text-center">
    <span class="eyebrow">404</span>
    <h1 class="mt-4 font-display text-display-lg font-semibold tracking-tighter text-white">Page not found</h1>
    <p class="mt-4 max-w-md text-ink-300">The page you were looking for does not exist or has moved.</p>
    <div class="mt-8 flex gap-3">
      <a href={withBase('/')} class="btn-secondary">Home</a>
      <a href={withBase('/docs/getting-started/')} class="btn-primary">Quickstart</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
