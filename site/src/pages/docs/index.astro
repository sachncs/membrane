---
import { getCollection } from 'astro:content';
import DocsLayoutHome from '../../layouts/DocsHome.astro';
import { DOCS_NAV } from '../../lib/docs-nav';
import { summaryOf } from '../../lib/docs-summary';
import { withBase } from '../../lib/site';

const entries = await getCollection('docs');
const summaries = new Map(entries.map((e) => [e.id, summaryOf(e.body ?? '')]));
const short = (text: string) => (text.length > 150 ? `${text.slice(0, text.lastIndexOf(' ', 147))}…` : text);

const starts = [
  { title: 'Quickstart', body: 'From a fresh clone to a running node and your first cache hit in about five minutes.', href: '/docs/getting-started/' },
  { title: 'Deploy to production', body: 'Docker, Kubernetes, TLS, persistence, and the settings a production node needs.', href: '/docs/deployment/' },
  { title: 'Security model', body: 'Authentication, tenant isolation, encryption at rest, and audit logging.', href: '/docs/security/' },
];
---

<DocsLayoutHome>
  <div class="mx-auto max-w-[64rem]">
    <p class="eyebrow">Documentation</p>
    <h1 class="mt-3 font-display text-[2.5rem] font-semibold leading-tight tracking-tight text-white">Membrane documentation</h1>
    <p class="mt-4 max-w-2xl text-[1.125rem] leading-relaxed text-ink-300">
      Install, run, secure, and operate Membrane, the shared KV-cache for LLM serving. Start with the
      quickstart, or jump to the guide for what you are doing.
    </p>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        starts.map((s, i) => (
          <a href={withBase(s.href)} class={`card group p-5 transition-colors hover:border-white/20 ${i === 0 ? 'border-brand-400/30' : ''}`}>
            <div class="flex items-center justify-between">
              <h2 class="font-semibold text-white group-hover:text-brand-300">{s.title}</h2>
              <span class="text-ink-500 group-hover:text-brand-300" aria-hidden="true">→</span>
            </div>
            <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-300">{s.body}</p>
          </a>
        ))
      }
    </div>

    <div class="mt-16 space-y-14">
      {
        DOCS_NAV.map((section) => (
          <section>
            <h2 class="text-[1.25rem] font-semibold tracking-tight text-white">{section.title}</h2>
            <div class="mt-5 grid gap-px overflow-hidden rounded-xl border border-white/[0.08] bg-white/[0.08] sm:grid-cols-2">
              {section.items.map((item) => (
                <a href={withBase(`/docs/${item.id}/`)} class="group bg-ink-900 p-5 transition-colors hover:bg-ink-850">
                  <div class="font-medium text-white group-hover:text-brand-300">{item.label}</div>
                  <p class="mt-1.5 text-[0.875rem] leading-relaxed text-ink-400">{short(summaries.get(item.id) ?? '')}</p>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</DocsLayoutHome>
