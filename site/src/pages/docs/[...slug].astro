---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { DOCS_ORDER } from '../../lib/docs-nav';
import { summaryOf } from '../../lib/docs-summary';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  const known = new Set(DOCS_ORDER.map((item) => item.id));
  const missing = entries.filter((entry) => !known.has(entry.id)).map((entry) => entry.id);
  if (missing.length) {
    throw new Error(`docs not listed in src/lib/docs-nav.ts: ${missing.join(', ')}`);
  }
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const title = headings.find((h) => h.depth === 1)?.text ?? entry.id;
---

<DocsLayout id={entry.id} title={title} description={summaryOf(entry.body ?? '')} headings={headings}>
  <Content />
</DocsLayout>
