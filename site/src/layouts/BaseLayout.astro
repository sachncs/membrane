---
import '../styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Membrane — Global Contextual Memory Fabric',
  description = 'Distributed, content-addressed KV-cache sharing across LLM serving clusters. The reference implementation of Prefill-as-a-Service.',
  ogImage = '/og.svg',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconHref = `${base}/favicon.svg`;
const ogImageHref = `${base}${ogImage}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" class="dark no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050507" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:site_name" content="Membrane" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="font-sans antialiased text-ink-50 selection:bg-accent-violet/30">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-ink-950"
    >
      Skip to content
    </a>
    <slot />

    <script>
      // Strip the no-js fallback class as soon as JS executes.
      document.documentElement.classList.remove('no-js');

      // Reveal-on-scroll observer — runs once after DOM ready.
      const init = () => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window) || !els.length) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        els.forEach((el) => io.observe(el));
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }

      // Animated counters for the perf section.
      const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
      if (counters.length) {
        const animate = (el: HTMLElement) => {
          const target = parseFloat(el.dataset.counter || '0');
          const decimals = parseInt(el.dataset.decimals || '0', 10);
          const duration = 1600;
          const start = performance.now();
          const step = (now: number) => {
            const t = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - t, 3);
            const value = target * eased;
            el.textContent =
              decimals > 0
                ? value.toFixed(decimals)
                : Math.round(value).toLocaleString();
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        const io2 = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                animate(e.target as HTMLElement);
                io2.unobserve(e.target);
              }
            });
          },
          { threshold: 0.4 }
        );
        counters.forEach((el) => io2.observe(el));
      }
    </script>
  </body>
</html>
