---
import '../styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Membrane — the shared KV-cache for LLM serving',
  description = 'Membrane stores prefill results once and serves them to every node in your LLM fleet: content-addressed, tenant-isolated, and authenticated by default. Open source.',
  ogImage = '/og.png',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconHref = `${base}/favicon.svg`;
// Crawlers need an absolute image URL.
const ogImageHref = new URL(`${base}${ogImage}`, Astro.site).toString();
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#08090b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Membrane" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="font-sans antialiased text-ink-50 selection:bg-brand-400/30">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-ink-950"
    >
      Skip to content
    </a>
    <slot />

  </body>
</html>
