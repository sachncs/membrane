---
import BaseLayout from './BaseLayout.astro';
import DocsHeader from '../components/DocsHeader.astro';
import { DOCS_NAV, DOCS_ORDER } from '../lib/docs-nav';
import { BLOB_URL, withBase } from '../lib/site';

export interface Props {
  id: string;
  title: string;
  description?: string;
  headings: { depth: number; slug: string; text: string }[];
}

const { id, title, description = '', headings } = Astro.props;
const index = DOCS_ORDER.findIndex((item) => item.id === id);
const prev = index > 0 ? DOCS_ORDER[index - 1] : undefined;
const next = index >= 0 && index < DOCS_ORDER.length - 1 ? DOCS_ORDER[index + 1] : undefined;
const section = DOCS_NAV.find((s) => s.items.some((item) => item.id === id));
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const editUrl = `${BLOB_URL}/docs/${id}.md`;
---

<BaseLayout title={`${title} · Membrane docs`} description={description || `Membrane documentation: ${title}.`}>
  <DocsHeader />
  <div class="mx-auto w-full max-w-[1440px] px-5 pt-16 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_14rem]">
      <aside class="lg:sticky lg:top-16 lg:h-[calc(100vh-4rem)] lg:overflow-y-auto lg:py-8 lg:pr-2" aria-label="Documentation">
        <details class="mt-6 rounded-lg border border-white/[0.08] bg-white/[0.02] px-4 py-3 lg:hidden">
          <summary class="cursor-pointer text-[0.875rem] font-medium text-ink-100">{section?.title ?? 'Docs'} · {DOCS_ORDER[index]?.label}</summary>
          <nav class="mt-3 space-y-4">
            {
              DOCS_NAV.map((s) => (
                <div>
                  <div class="text-[0.75rem] font-semibold text-ink-100">{s.title}</div>
                  <ul class="mt-1">
                    {s.items.map((item) => (
                      <li>
                        <a href={withBase(`/docs/${item.id}/`)} class={`block py-1 text-[0.875rem] ${item.id === id ? 'text-brand-300' : 'text-ink-300'}`}>{item.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </nav>
        </details>
        <nav class="docs-sidebar hidden space-y-7 lg:block">
          <a href={withBase('/docs/')} class={`sidebar-link ${id === '' ? 'is-active' : ''}`}>Overview</a>
          {
            DOCS_NAV.map((s) => (
              <div>
                <div class="mb-2 text-[0.75rem] font-semibold text-ink-100">{s.title}</div>
                <ul class="space-y-px border-l border-white/[0.07]">
                  {s.items.map((item) => (
                    <li>
                      <a href={withBase(`/docs/${item.id}/`)} aria-current={item.id === id ? 'page' : undefined} class={`sidebar-link ${item.id === id ? 'is-active' : ''}`}>
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      <main id="main" class="min-w-0 pb-24 pt-8 lg:pt-10">
        <article data-pagefind-body class="mx-auto max-w-[46rem]">
          <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-1.5 text-[0.8125rem] text-ink-400">
            <a href={withBase('/docs/')} class="hover:text-white">Docs</a>
            {section && (<><span aria-hidden="true">/</span><span>{section.title}</span></>)}
          </nav>
          <div class="docs-prose">
            <slot />
          </div>

          <div class="mt-14 flex flex-wrap items-center justify-between gap-3 border-t border-white/[0.07] pt-6 text-[0.875rem]">
            <a href={editUrl} target="_blank" rel="noreferrer noopener" class="inline-flex items-center gap-1.5 text-ink-400 hover:text-white">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4Z" /><path d="m13.5 6.5 4 4" /></svg>
              Edit this page on GitHub
            </a>
          </div>

          <nav class="mt-8 grid gap-3 sm:grid-cols-2" aria-label="Pagination" data-pagefind-ignore>
            {prev ? (
              <a href={withBase(`/docs/${prev.id}/`)} class="card group p-4 transition-colors hover:border-white/20">
                <div class="text-[0.75rem] text-ink-400">Previous</div>
                <div class="mt-1 font-medium text-white group-hover:text-brand-300">← {prev.label}</div>
              </a>
            ) : <span />}
            {next && (
              <a href={withBase(`/docs/${next.id}/`)} class="card group p-4 text-right transition-colors hover:border-white/20">
                <div class="text-[0.75rem] text-ink-400">Next</div>
                <div class="mt-1 font-medium text-white group-hover:text-brand-300">{next.label} →</div>
              </a>
            )}
          </nav>
        </article>
      </main>

      {
        toc.length > 1 && (
          <aside class="hidden py-10 xl:sticky xl:top-16 xl:block xl:h-[calc(100vh-4rem)] xl:overflow-y-auto" aria-label="On this page">
            <div class="text-[0.75rem] font-semibold text-ink-100">On this page</div>
            <ul class="mt-3 space-y-1.5 border-l border-white/[0.07]">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc-link={h.slug} class={`toc-link ${h.depth === 3 ? 'pl-6' : 'pl-3'}`}>{h.text}</a>
                </li>
              ))}
            </ul>
            <a href={editUrl} target="_blank" rel="noreferrer noopener" class="mt-6 block text-[0.8125rem] text-ink-400 hover:text-white">Edit this page ↗</a>
          </aside>
        )
      }
    </div>
  </div>
  <footer class="border-t border-white/[0.06] py-8 text-center text-[0.8125rem] text-ink-500">
    Membrane is open source under the MIT License.
  </footer>
</BaseLayout>

<script>
  // Highlight the section being read in the "On this page" rail.
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => links.set(a.dataset.tocLink!, a));
  if (links.size) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a) => a.classList.remove('is-active'));
          links.get(entry.target.id)?.classList.add('is-active');
        }
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );
    links.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>
