---
import Logo from './Logo.astro';
import { REPO_URL, VERSION, BLOB_URL, withBase } from '../lib/site';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.07] bg-ink-950/85 backdrop-blur-lg">
  <div class="mx-auto flex h-16 w-full max-w-[1440px] items-center gap-4 px-5 sm:px-8">
    <a href={withBase('/')} class="flex items-center gap-2.5" aria-label="Membrane home"><Logo /></a>
    <span class="h-5 w-px bg-white/10" aria-hidden="true"></span>
    <a href={withBase('/docs/')} class="text-[0.9rem] font-medium text-ink-200 hover:text-white">Docs</a>

    <button
      type="button"
      data-search-open
      class="ml-4 hidden h-9 w-full max-w-[22rem] items-center gap-2 rounded-lg border border-white/[0.08] bg-white/[0.03] px-3 text-left text-[0.875rem] text-ink-400 transition-colors hover:border-white/15 hover:text-ink-200 md:flex"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
      <span class="flex-1">Search docs</span>
      <kbd class="rounded border border-white/10 px-1.5 py-0.5 font-mono text-[0.6875rem] text-ink-400">⌘K</kbd>
    </button>

    <div class="ml-auto flex items-center gap-1">
      <button type="button" data-search-open class="btn-ghost md:hidden" aria-label="Search docs">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
      </button>
      <a href={`${BLOB_URL}/CHANGELOG.md`} class="btn-ghost hidden lg:inline-flex">Changelog</a>
      <a href={`${REPO_URL}/releases`} class="hidden rounded-md border border-white/10 px-2 py-1 font-mono text-[0.75rem] text-ink-300 hover:text-white sm:inline-block">v{VERSION}</a>
      <a href={REPO_URL} target="_blank" rel="noreferrer noopener" class="btn-ghost" aria-label="GitHub repository">
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<dialog data-search-dialog class="search-dialog" aria-label="Search the documentation">
  <div class="flex items-center justify-between border-b border-white/[0.07] px-4 py-3">
    <span class="text-[0.8125rem] font-medium text-ink-300">Search the documentation</span>
    <button type="button" data-search-close class="rounded px-2 py-0.5 font-mono text-[0.75rem] text-ink-400 hover:text-white">Esc</button>
  </div>
  <div id="docs-search" class="px-4 py-4"></div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  let loaded = false;
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');

  async function open() {
    if (!dialog) return;
    if (!loaded) {
      loaded = true;
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = `${base}/pagefind/pagefind-ui.css`;
      document.head.appendChild(css);
      await new Promise<void>((resolve, reject) => {
        const script = document.createElement('script');
        script.src = `${base}/pagefind/pagefind-ui.js`;
        script.onload = () => resolve();
        script.onerror = () => reject(new Error('search index unavailable'));
        document.head.appendChild(script);
      }).catch(() => undefined);
      const PagefindUI = (window as unknown as { PagefindUI?: new (o: object) => unknown }).PagefindUI;
      if (PagefindUI) {
        new PagefindUI({ element: '#docs-search', showSubResults: true, showImages: false, resetStyles: false });
      } else {
        const target = document.getElementById('docs-search');
        if (target) target.textContent = 'Search is available on the published site (run npm run build).';
      }
    }
    dialog.showModal();
    setTimeout(() => dialog.querySelector<HTMLInputElement>('input')?.focus(), 50);
  }

  document.querySelectorAll('[data-search-open]').forEach((el) => el.addEventListener('click', open));
  document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      open();
    }
  });
</script>
