---
// One stroke-icon set (24px grid, 1.75 stroke) for every feature.
const icons: Record<string, string> = {
  layers: '<path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="m3 13 9 5 9-5"/><path d="m3 18 9 5 9-5" opacity=".5"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>',
  rebuild: '<path d="M4 12a8 8 0 0 1 13.7-5.7L20 8.5"/><path d="M20 4v4.5h-4.5"/><path d="M20 12a8 8 0 0 1-13.7 5.7L4 15.5"/><path d="M4 20v-4.5h4.5"/>',
  route: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.5 6H14a4 4 0 0 1 0 8h-4a4 4 0 0 0 0 8h5.5" transform="translate(0 -2)"/>',
  ring: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="4" r="1.8" fill="currentColor"/><circle cx="19" cy="15.5" r="1.8" fill="currentColor"/><circle cx="5" cy="15.5" r="1.8" fill="currentColor"/>',
  shield: '<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.3 7.5 9.5 4.3-1.2 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m9 12 2 2 4-4"/>',
  chip: '<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3"/>',
  terminal: '<rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="m7.5 9.5 3 2.5-3 2.5M13 15h4"/>',
};

const features = [
  {
    icon: 'layers',
    title: 'Content-addressed fragments',
    body: 'KV segments keyed by a ten-field identity hash. Identical content is stored once; each tenant keeps its own copy of the metadata.',
  },
  {
    icon: 'search',
    title: 'Four indices, one lookup',
    body: 'Exact, semantic, positional, and co-access indices over the same fragments, behind a single Index API.',
  },
  {
    icon: 'rebuild',
    title: 'Reconstruction engine',
    body: 'Rebuilds a context from cached fragments and prefills only the uncovered spans, never the whole prompt.',
  },
  {
    icon: 'route',
    title: 'Cache-aware routing',
    body: 'Economic, latency, and joint routers send each request to the node that already holds its context.',
  },
  {
    icon: 'ring',
    title: 'A cluster that heals',
    body: 'Consistent-hash ring, gossip membership, failure detection, byte-verified replication, and quorum writes.',
  },
  {
    icon: 'shield',
    title: 'Secure by default',
    body: 'API keys or mTLS on every route, per-tenant reads, AES-256-GCM at rest, and a tamper-evident audit log.',
  },
  {
    icon: 'chip',
    title: 'Bring your engine',
    body: 'Adapters for vLLM, SGLang, and TensorRT-LLM; backends for Transformers, OpenAI, Anthropic, and Ollama.',
  },
  {
    icon: 'terminal',
    title: 'Operable',
    body: 'Prometheus metrics, OpenTelemetry traces, a live dashboard, and admin commands to inspect and repair.',
  },
];
---

<section id="features" class="section border-t border-white/[0.06]">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">Features</p>
      <h2 class="h-section mt-3">Everything a shared KV‑cache needs in production.</h2>
      <p class="lede mt-4">
        Storage, lookup, routing, and cluster primitives, with the security and operations work already
        done.
      </p>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/[0.08] bg-white/[0.08] sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((f) => (
          <div class="bg-ink-900 p-6">
            <span class="icon-tile">
              <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[f.icon]} />
            </span>
            <h3 class="mt-5 text-[1rem] font-semibold text-white">{f.title}</h3>
            <p class="mt-2 text-[0.9rem] leading-relaxed text-ink-300">{f.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
