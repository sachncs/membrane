---
import { withBase } from '../lib/site';

const planes = [
  { title: 'Client surface', desc: 'How engines and operators talk to a node.', items: ['Python SDK (sync + async)', 'HTTP + mTLS', 'OpenAPI 3', 'CLI and dashboard'] },
  { title: 'Routing', desc: 'Which node serves a request.', items: ['Economic router', 'Latency router', 'Joint optimizer', 'Workload analyzer'] },
  { title: 'Index', desc: 'Finding the fragments that cover a prompt.', items: ['Exact', 'Semantic', 'Positional', 'Co-access'] },
  { title: 'Cluster fabric', desc: 'Where fragments live, and keeping them there.', items: ['Consistent-hash ring', 'Gossip membership', 'Byte-verified replication', 'Failure detection'] },
  { title: 'Storage', desc: 'The bytes, in memory and on disk.', items: ['In-memory store', 'Warm tier on disk', 'Redis (Sentinel, Cluster)', 'AES-256-GCM at rest'] },
];
---

<section id="architecture" class="section border-t border-white/[0.06]">
  <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:gap-16">
    <div class="min-w-0">
      <p class="eyebrow">Architecture</p>
      <h2 class="h-section mt-3">Five planes, one runtime.</h2>
      <p class="lede mt-4">
        The same Python runtime runs as a single node or a gossip-meshed fleet: same code, same
        semantics, same wire format. Compute, storage, persistence, eviction, placement, auth, and
        secrets are plugins you can replace without forking.
      </p>
      <a href={withBase('/docs/architecture/')} class="btn-secondary mt-8">
        Read the architecture
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8h9M8.5 4l4 4-4 4" /></svg>
      </a>
    </div>

    <ol class="min-w-0 space-y-2.5">
      {
        planes.map((p, i) => (
          <li class="card grid gap-3 p-4 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-center sm:gap-5 sm:p-5">
            <div class="flex items-start gap-3">
              <span class="mt-0.5 font-mono text-[0.75rem] text-brand-300">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <div class="text-[0.9375rem] font-semibold text-white">{p.title}</div>
                <div class="mt-0.5 text-[0.8125rem] leading-snug text-ink-400">{p.desc}</div>
              </div>
            </div>
            <ul class="flex flex-wrap gap-1.5">
              {p.items.map((item) => (
                <li class="rounded-md border border-white/[0.07] bg-white/[0.03] px-2.5 py-1 text-[0.8125rem] text-ink-200">{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
