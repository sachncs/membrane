---
import { INSTALL_COMMANDS, REPO_URL, withBase } from '../lib/site';
---

<section class="pb-24 sm:pb-28">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-2xl border border-white/[0.08] bg-ink-900 px-6 py-12 sm:px-12 sm:py-14">
      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-brand-500/15 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid items-center gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
        <div>
          <h2 class="text-balance font-display text-display-md font-semibold text-white">Run a node in five minutes.</h2>
          <p class="lede mt-3 max-w-md">Python 3.14, locked dependencies, no account. The quickstart takes you from clone to a cache hit.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href={withBase('/docs/getting-started/')} class="btn-primary">Read the quickstart</a>
            <a href={REPO_URL} target="_blank" rel="noreferrer noopener" class="btn-secondary">Star on GitHub</a>
          </div>
        </div>
        <div class="window min-w-0">
          <div class="window-bar"><span class="font-mono text-[0.75rem] text-ink-400">install from source</span></div>
          <pre class="code-block overflow-x-auto px-5 py-4 text-[0.78rem] leading-[1.75] text-ink-200">{INSTALL_COMMANDS}</pre>
        </div>
      </div>
    </div>
  </div>
</section>
