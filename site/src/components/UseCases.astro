---
const cases = [
  {
    audience: 'LLM serving teams',
    title: 'Cut time-to-first-token without re-architecting inference.',
    body: 'Run Membrane next to vLLM, SGLang, or TensorRT-LLM through the bundled adapters. Shared system prompts and documents come back from cache instead of being prefilled again.',
  },
  {
    audience: 'Multi-tenant platforms',
    title: 'Share the cache, not the data.',
    body: 'Every tenant keeps its own copy of a fragment and can only read its own. A cross-tenant read is indistinguishable from a miss, and identical bytes are still stored once.',
  },
  {
    audience: 'Research and infrastructure',
    title: 'A faithful reference of the paper.',
    body: 'The analytical throughput model, a Table-5 fit, and an end-to-end simulator. Reproduce, stress, and extend Prefill-as-a-Service on real code.',
  },
];
---

<section id="use-cases" class="section border-t border-white/[0.06]">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">Built for</p>
      <h2 class="h-section mt-3">Wherever prefill is the bottleneck.</h2>
    </div>
    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      {
        cases.map((c) => (
          <article class="card flex flex-col p-6 sm:p-7">
            <p class="text-[0.8125rem] font-medium text-brand-300">{c.audience}</p>
            <h3 class="mt-3 text-[1.125rem] font-semibold leading-snug text-white">{c.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-300">{c.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
