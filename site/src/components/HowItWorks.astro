---
const steps = [
  {
    n: '01',
    title: 'Prefill once',
    body: 'A node runs prefill and cuts the KV-cache into token windows. Each window becomes a fragment addressed by its hash: model, layers, heads, tokens, dtype, and bytes.',
  },
  {
    n: '02',
    title: 'Share across the fleet',
    body: 'Fragments are placed on a consistent-hash ring and replicated with their bytes. Gossip tells every node where they live; identical content is stored once.',
  },
  {
    n: '03',
    title: 'Reconstruct, don’t recompute',
    body: 'When a prompt arrives, Membrane rebuilds its context from cached fragments and prefills only the gaps. Full coverage means no prefill at all.',
  },
];
---

<section id="how-it-works" class="section">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">How it works</p>
      <h2 class="h-section mt-3">Prefill is the expensive part. Do it once.</h2>
      <p class="lede mt-4">
        Most serving fleets recompute the same system prompts, documents, and chat histories on every
        node. Membrane turns that work into a shared, addressable cache.
      </p>
    </div>

    <ol class="mt-14 grid gap-5 lg:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="card flex flex-col p-6">
            <div class="flex h-36 items-center justify-center rounded-xl border border-white/[0.06] bg-ink-950/70 px-4">
              {i === 0 && (
                <div class="w-full">
                  <div class="flex h-7 w-full overflow-hidden rounded-md text-[0.6875rem] font-mono">
                    <span class="flex w-[43%] items-center justify-center bg-brand-400/80 text-ink-950">0–127</span>
                    <span class="flex w-[43%] items-center justify-center border-l border-ink-950 bg-brand-400/60 text-ink-950">128–255</span>
                    <span class="flex w-[14%] items-center justify-center border-l border-ink-950 bg-brand-400/40 text-ink-950">…</span>
                  </div>
                  <div class="mt-3 grid grid-cols-3 gap-2 font-mono text-[0.6875rem] text-ink-400">
                    <span>1fbfae53…</span><span>ad9a27a8…</span><span>8668eeed…</span>
                  </div>
                </div>
              )}
              {i === 1 && (
                <svg viewBox="0 0 200 120" class="h-full w-auto" aria-hidden="true">
                  <circle cx="100" cy="60" r="42" fill="none" stroke="rgba(255,255,255,0.12)" stroke-dasharray="3 4" />
                  {[0, 72, 144, 216, 288].map((deg, k) => {
                    const r = (deg - 90) * (Math.PI / 180);
                    const x = 100 + 42 * Math.cos(r);
                    const y = 60 + 42 * Math.sin(r);
                    return (
                      <g>
                        <rect x={x - 11} y={y - 11} width="22" height="22" rx="6" fill="#14161a" stroke={k === 0 ? '#2dd4bf' : 'rgba(255,255,255,0.18)'} />
                        <circle cx={x} cy={y} r="3" fill={k === 0 || k === 2 ? '#2dd4bf' : '#40454e'} />
                      </g>
                    );
                  })}
                  <path d="M100 29 Q 165 45 124.7 83" fill="none" stroke="#2dd4bf" stroke-width="1.5" stroke-dasharray="2 3" />
                </svg>
              )}
              {i === 2 && (
                <div class="w-full space-y-3">
                  <div>
                    <div class="mb-1.5 flex justify-between text-[0.75rem] text-ink-400"><span>Cached prompt</span><span class="text-brand-300">coverage 1.0</span></div>
                    <div class="h-2.5 rounded-full bg-brand-400" />
                  </div>
                  <div>
                    <div class="mb-1.5 flex justify-between text-[0.75rem] text-ink-400"><span>New suffix</span><span>prefill 44 tokens</span></div>
                    <div class="flex h-2.5 overflow-hidden rounded-full">
                      <span class="w-[85%] bg-brand-400" />
                      <span class="w-[15%] bg-signal-amber/80" />
                    </div>
                  </div>
                </div>
              )}
            </div>
            <div class="mt-6 font-mono text-[0.75rem] text-ink-500">{s.n}</div>
            <h3 class="mt-1 text-[1.125rem] font-semibold text-white">{s.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-300">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
