---
// The Membrane mark: a ring (the membrane) with an opening, a fragment
// inside, and one passing through: KV computed once, shared outward.
export interface Props {
  size?: number;
  withWordmark?: boolean;
}
const { size = 28, withWordmark = true } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <rect x="0.5" y="0.5" width="31" height="31" rx="8" fill="#101115" stroke="rgba(255,255,255,0.1)" />
    <path d="M22.51 10.54A8.5 8.5 0 1 0 22.51 21.46" stroke="#2dd4bf" stroke-width="2.4" stroke-linecap="round" />
    <circle cx="16" cy="16" r="2.4" fill="#f5f6f8" />
    <circle cx="25.2" cy="16" r="2.4" fill="#2dd4bf" />
  </svg>
  {withWordmark && <span class="text-[0.95rem] font-semibold tracking-tight text-white">Membrane</span>}
</span>
