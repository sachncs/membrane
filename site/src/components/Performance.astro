---
import { REPO_URL } from '../lib/site';

// Output of `python scripts/demo.py`: the analytical model on the paper's
// Section 4 case study (20,000 requests, mean input 27.5K tokens).
// Update these when the model changes; the demo is run in CI.
const metrics = [
  { value: 1.39, suffix: '×', decimals: 2, label: 'Max sustainable request rate', detail: '3.12 vs 2.25 req/s against homogeneous PD.' },
  { value: 42, suffix: '%', decimals: 0, label: 'Lower mean TTFT', detail: '2.31 s vs 4.00 s against homogeneous PD.' },
  { value: 10, suffix: '%', decimals: 0, label: 'Lower P90 TTFT', detail: '3.62 s vs 4.00 s against homogeneous PD.' },
  { value: 4.8, suffix: 'Gbps', decimals: 1, label: 'Average egress', detail: 'Cross-datacenter KV traffic the routing threshold induces.' },
];

const configs = [
  { name: 'Homogeneous PD', lambda: 2.25, ttft: 4.0 },
  { name: 'Naive heterogeneous PD', lambda: 2.5, ttft: 1.65 },
  { name: 'Membrane-PD', lambda: 3.12, ttft: 2.31, highlight: true },
];
const maxLambda = Math.max(...configs.map((c) => c.lambda));
const maxTtft = Math.max(...configs.map((c) => c.ttft));
---

<section id="performance" class="relative py-24 sm:py-32 lg:py-40">
  <div class="container-page">
    <div class="grid items-start gap-16 lg:grid-cols-12 lg:gap-12">
      <div class="min-w-0 lg:col-span-5">
        <span data-reveal class="eyebrow">Performance model</span>
        <h2
          data-reveal
          data-reveal-delay="1"
          class="mt-4 text-balance font-display text-display-lg font-semibold tracking-tighter text-white"
        >
          The paper's case study, <br />
          <span class="gradient-text-static">reproduced in one command.</span>
        </h2>
        <p
          data-reveal
          data-reveal-delay="2"
          class="mt-5 max-w-md text-pretty text-[1.0625rem] leading-relaxed text-ink-200"
        >
          <code class="rounded bg-white/[0.06] px-1.5 py-0.5 font-mono text-[0.85em] text-ink-100">membrane/model/throughput.py</code>
          implements Eqs. (1)–(6) of the Prefill-as-a-Service paper with a
          piecewise-linear Table-5 fit. These numbers are the model's output for
          the paper's Section 4 workload, not a benchmark of a live cluster.
        </p>
        <div data-reveal data-reveal-delay="3" class="mt-6 overflow-hidden rounded-xl border border-white/[0.08] bg-ink-950/60">
          <pre class="code-block overflow-x-auto px-4 py-3 text-[0.82rem] text-ink-100"><span class="text-accent-mint">$</span> python scripts/demo.py</pre>
        </div>

        <div data-reveal data-reveal-delay="3" class="mt-6 flex flex-wrap gap-3">
          <a href="https://arxiv.org/abs/2604.15039" target="_blank" rel="noreferrer noopener" class="btn-secondary">
            Read the paper
          </a>
          <a href={`${REPO_URL}/blob/master/scripts/demo.py`} target="_blank" rel="noreferrer noopener" class="btn-ghost">
            View the script
          </a>
        </div>
      </div>

      <div class="min-w-0 lg:col-span-7">
        <div class="grid gap-3 sm:grid-cols-2">
          {
            metrics.map((m, i) => (
              <div data-reveal data-reveal-delay={i + 1} class="card relative overflow-hidden p-7">
                <div class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-gradient-to-br from-accent-violet/20 to-transparent blur-2xl" aria-hidden="true" />
                <div class="relative">
                  <div class="flex items-baseline gap-1.5">
                    <span
                      class="font-display text-[2.75rem] font-semibold leading-none tracking-tightest text-white"
                      data-counter={m.value}
                      data-decimals={m.decimals}
                    >
                      {m.value.toFixed(m.decimals)}
                    </span>
                    <span class="font-display text-2xl font-semibold text-ink-300">{m.suffix}</span>
                  </div>
                  <div class="mt-3 text-[0.9rem] font-medium text-ink-100">{m.label}</div>
                  <div class="mt-1.5 text-[0.82rem] leading-relaxed text-ink-300">{m.detail}</div>
                </div>
              </div>
            ))
          }
        </div>

        <div data-reveal data-reveal-delay="3" class="card mt-3 p-6 sm:p-8">
          <div class="text-[0.78rem] font-medium text-ink-300">Configurations compared by the model</div>
          <div class="mt-4 overflow-x-auto">
          <table class="w-full min-w-[420px] text-left text-[0.82rem]">
            <thead class="text-ink-400">
              <tr>
                <th class="pb-2 font-medium">Configuration</th>
                <th class="pb-2 font-medium">Max rate (req/s)</th>
                <th class="pb-2 font-medium">Mean TTFT (s)</th>
              </tr>
            </thead>
            <tbody>
              {
                configs.map((c) => (
                  <tr class="border-t border-white/[0.06]">
                    <td class={`py-2.5 pr-4 ${c.highlight ? 'font-medium text-white' : 'text-ink-200'}`}>{c.name}</td>
                    <td class="py-2.5 pr-4">
                      <div class="flex items-center gap-2">
                        <div class="h-1.5 w-24 rounded-full bg-white/[0.06]">
                          <div class={`h-1.5 rounded-full ${c.highlight ? 'bg-accent-cyan' : 'bg-white/25'}`} style={`width: ${(c.lambda / maxLambda) * 100}%`} />
                        </div>
                        <span class="font-mono text-ink-100">{c.lambda.toFixed(2)}</span>
                      </div>
                    </td>
                    <td class="py-2.5">
                      <div class="flex items-center gap-2">
                        <div class="h-1.5 w-24 rounded-full bg-white/[0.06]">
                          <div class={`h-1.5 rounded-full ${c.highlight ? 'bg-accent-violet' : 'bg-white/25'}`} style={`width: ${(c.ttft / maxTtft) * 100}%`} />
                        </div>
                        <span class="font-mono text-ink-100">{c.ttft.toFixed(2)}</span>
                      </div>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          </div>
          <p class="mt-4 text-[0.75rem] leading-relaxed text-ink-400">
            Naive heterogeneous PD has the lowest TTFT but saturates at 2.50 req/s; Membrane-PD's
            length-threshold routing trades some latency for the highest sustainable rate.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
