---
import { BLOB_URL } from '../lib/site';

// Measured in this repository (docs/deployment.md, docs/operations/capacity.md).
const measured = [
  { value: '8.1M', unit: 'reads/s', label: 'One node, 4 threads', detail: '3.2× one thread on free-threaded Python 3.14. CI requires ≥ 3.0× on 8+ CPU hosts.' },
  { value: '1.6×', unit: '', label: 'Read capacity, 3 → 5 nodes', detail: '1,848 → 2,955 reads/s on kind with 250m CPU per pod. CI fails below 1.5×.' },
  { value: '15.4k', unit: 'req/s', label: 'HTTP /retrieve, one node', detail: 'Two event loops on free-threaded Python, keep-alive; the load generator saturates beyond.' },
];

// Output of `python scripts/demo.py`: the analytical model on the paper's
// Section 4 case study (20,000 requests, mean input 27.5K tokens).
// Update these when the model changes; the demo is run in CI.
const modeled = [
  { value: '1.39×', label: 'Max sustainable request rate', detail: '3.12 vs 2.25 req/s' },
  { value: '42%', label: 'Lower mean TTFT', detail: '2.31 s vs 4.00 s' },
  { value: '10%', label: 'Lower P90 TTFT', detail: '3.62 s vs 4.00 s' },
];
const configs = [
  { name: 'Homogeneous PD', lambda: 2.25, ttft: 4.0 },
  { name: 'Naive heterogeneous PD', lambda: 2.5, ttft: 1.65 },
  { name: 'Membrane-PD', lambda: 3.12, ttft: 2.31, highlight: true },
];
const maxLambda = Math.max(...configs.map((c) => c.lambda));
---

<section id="performance" class="section border-t border-white/[0.06]">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">Performance</p>
      <h2 class="h-section mt-3">Scales with cores. Scales with nodes.</h2>
      <p class="lede mt-4">
        Measured numbers come from this repository's benchmarks and CI jobs. The modeled numbers
        reproduce the Prefill-as-a-Service paper's case study, and are labelled as such.
      </p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-2">
      <div class="card p-6 sm:p-8">
        <div class="flex items-center justify-between">
          <h3 class="text-[0.9375rem] font-semibold text-white">Measured</h3>
          <span class="chip">Benchmarks and CI</span>
        </div>
        <dl class="mt-6 divide-y divide-white/[0.06]">
          {
            measured.map((m) => (
              <div class="grid gap-1 py-5 first:pt-0 last:pb-0 sm:grid-cols-[9.5rem_minmax(0,1fr)] sm:gap-6">
                <dd class="font-display text-[1.875rem] font-semibold leading-none tracking-tight text-white">
                  {m.value}
                  {m.unit && <span class="ml-1 text-[0.875rem] font-medium tracking-normal text-ink-400">{m.unit}</span>}
                </dd>
                <div>
                  <dt class="text-[0.9375rem] font-medium text-ink-100">{m.label}</dt>
                  <dd class="mt-1 text-[0.875rem] leading-relaxed text-ink-400">{m.detail}</dd>
                </div>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="card p-6 sm:p-8">
        <div class="flex items-center justify-between">
          <h3 class="text-[0.9375rem] font-semibold text-white">Modeled: the paper’s case study</h3>
          <code class="chip font-mono text-[0.75rem]">scripts/demo.py</code>
        </div>
        <dl class="mt-6 grid grid-cols-3 gap-4">
          {
            modeled.map((m) => (
              <div>
                <dd class="font-display text-[1.75rem] font-semibold leading-none tracking-tight text-white">{m.value}</dd>
                <dt class="mt-2 text-[0.8125rem] font-medium text-ink-200">{m.label}</dt>
                <dd class="mt-0.5 text-[0.8125rem] text-ink-400">{m.detail}</dd>
              </div>
            ))
          }
        </dl>
        <div class="mt-8 space-y-3">
          <div class="flex justify-between text-[0.75rem] text-ink-400"><span>Max request rate (req/s)</span><span>vs homogeneous PD</span></div>
          {
            configs.map((c) => (
              <div class="grid grid-cols-[10.5rem_minmax(0,1fr)_2.5rem] items-center gap-3 text-[0.8125rem]">
                <span class={c.highlight ? 'font-medium text-white' : 'text-ink-300'}>{c.name}</span>
                <span class="h-2 overflow-hidden rounded-full bg-white/[0.06]">
                  <span class={`block h-full rounded-full ${c.highlight ? 'bg-brand-400' : 'bg-ink-500'}`} style={`width:${(c.lambda / maxLambda) * 100}%`} />
                </span>
                <span class="text-right font-mono text-ink-200">{c.lambda.toFixed(2)}</span>
              </div>
            ))
          }
        </div>
        <p class="mt-6 text-[0.8125rem] leading-relaxed text-ink-500">
          Eqs. (1)–(6) of the paper with a piecewise-linear Table-5 fit, run on its Section 4
          workload. A model, not a benchmark of a live cluster.{' '}
          <a class="text-ink-300 underline decoration-white/20 underline-offset-2 hover:text-white" href={`${BLOB_URL}/membrane/model/throughput.py`}>Source</a>
        </p>
      </div>
    </div>
  </div>
</section>
