---
import { REPO_URL, VERSION, withBase } from '../lib/site';
---

<section class="relative overflow-hidden pt-28 sm:pt-32 lg:pt-36">
  <div class="pointer-events-none absolute inset-0 -z-10 grid-bg mask-radial" aria-hidden="true"></div>
  <div class="pointer-events-none absolute left-1/2 top-[-18rem] -z-10 h-[36rem] w-[60rem] -translate-x-1/2 rounded-full bg-brand-500/[0.07] blur-3xl" aria-hidden="true"></div>

  <div class="container-page grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-14">
    <div class="min-w-0">
      <a href={`${REPO_URL}/releases`} target="_blank" rel="noreferrer noopener" class="chip hover:border-white/20">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
        <span>v{VERSION} · Open source · MIT</span>
      </a>
      <h1 class="mt-6 max-w-[15ch] text-balance font-display text-display-xl font-semibold text-white">
        The shared KV‑cache for LLM serving.
      </h1>
      <p class="lede mt-6 max-w-[34rem] text-[1.125rem]">
        Membrane stores prefill results once and serves them to every node in your fleet.
        Repeated prompts skip prefill, time-to-first-token drops, and GPUs stop recomputing
        the same context.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={withBase('/docs/getting-started/')} class="btn-primary">
          Get started
          <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8h9M8.5 4l4 4-4 4" /></svg>
        </a>
        <a href={REPO_URL} target="_blank" rel="noreferrer noopener" class="btn-secondary">View on GitHub</a>
      </div>
      <ul class="mt-10 grid max-w-[36rem] grid-cols-1 gap-y-2.5 text-[0.875rem] text-ink-300">
        {
          [
            'Adapters for vLLM, SGLang, TensorRT-LLM',
            'Deduplicated, content-addressed storage',
            'mTLS or API keys on every route',
            'Tenant isolation, encryption at rest',
          ].map((item) => (
            <li class="flex items-start gap-2">
              <svg viewBox="0 0 16 16" class="mt-[3px] h-3.5 w-3.5 shrink-0 text-brand-400" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3 3 7-7" /></svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- A real session against one node: prefill once, then rebuild the same context from cache. -->
    <div class="relative min-w-0">
      <div class="window">
        <div class="window-bar">
          <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
          <span class="ml-2 font-mono text-[0.75rem] text-ink-400">node-a · :8080</span>
        </div>
        <pre class="code-block overflow-x-auto px-5 pb-14 pt-5 text-[0.8125rem] leading-[1.75] text-ink-200"><span class="text-ink-500"># 1. A prompt is prefilled once, anywhere in the fleet</span>
<span class="text-brand-400">$</span> curl -s :8080/prefill -d '&#123;"prompt_tokens": [0, …, 299],
         "model_id": "llama-3-8b"&#125;'
<span class="text-ink-400">→ 3 fragments stored   tokens 0–127 · 128–255 · 256–299</span>

<span class="text-ink-500"># 2. The same context, on any node, comes back from cache</span>
<span class="text-brand-400">$</span> curl -s :8080/reconstruct -d '&#123;"tokens": [0, …, 299],
         "model_id": "llama-3-8b"&#125;'
<span class="text-ink-100">&#123; "coverage": <span class="text-brand-300">1.0</span>, "prefilled": <span class="text-brand-300">false</span>,
  "fragments": [ "1fbfae53…", "ad9a27a8…", "8668eeed…" ] &#125;</span></pre>
      </div>

      <div class="card absolute -bottom-7 right-6 hidden items-center gap-3 px-4 py-3 sm:flex">
        <span class="grid h-8 w-8 place-items-center rounded-full bg-brand-400/15 text-brand-300">
          <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3 3 7-7" /></svg>
        </span>
        <div class="leading-tight">
          <div class="text-[0.875rem] font-medium text-white">Prefill skipped</div>
          <div class="text-[0.8125rem] text-ink-400">300 / 300 tokens served from cache</div>
        </div>
      </div>
    </div>
  </div>
</section>
