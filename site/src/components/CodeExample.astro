---
// Every snippet here is copied from docs/getting-started.md and is run
// as part of the test suite or the CI container smoke test.
import { INSTALL_COMMANDS } from '../lib/site';

const snippets = [
  {
    id: 'install',
    label: 'install',
    shell: true,
    code: INSTALL_COMMANDS,
  },
  {
    id: 'run',
    label: 'first run',
    shell: true,
    code: `$ membrane serve --daemon &
$ membrane client prefill --prompt-tokens "1 2 3 4 5 6 7 8"
$ membrane client inventory
$ membrane client retrieve --hash <payload_hash from inventory>`,
  },
  {
    id: 'python',
    label: 'python',
    shell: false,
    code: `import logging

from membrane.client import MembraneClient

logging.basicConfig(level=logging.INFO)
log = logging.getLogger("quickstart")

client = MembraneClient("http://localhost:8080")
result = client.prefill(list(range(256)), model_id="llama-3")
for frag in result["fragments"]:
    content_hash = frag["identity"]["payload_hash"]
    log.info("%s found=%s", content_hash, client.retrieve(content_hash)["found"])
client.close()`,
  },
  {
    id: 'secure',
    label: 'secure node',
    shell: true,
    code: `# Any non-loopback bind requires authentication.
# Keys are stored hashed; line 1 is the key, line 2 the keyfile entry.
$ membrane keys generate --subject ops --scope admin > ops.txt
$ sed -n 2p ops.txt > api-keys && chmod 600 api-keys
$ membrane serve --host 0.0.0.0 --api-key-file api-keys --daemon

# Or as a container (Python 3.14, read-only root, non-root user):
$ docker build -t membrane .
$ docker run --read-only --tmpfs /tmp -p 8080:8080 \\
    -v "$PWD/api-keys:/run/secrets/api-keys:ro" \\
    -e MEMBRANE_API_KEY_FILE=/run/secrets/api-keys membrane`,
  },
  {
    id: 'cluster',
    label: 'cluster',
    shell: true,
    code: `# Three local nodes; each seeds from the other two.
$ membrane serve -n n1 -p 8080 --daemon --peer localhost:8081 --peer localhost:8082 &
$ membrane serve -n n2 -p 8081 --daemon --peer localhost:8080 --peer localhost:8082 &
$ membrane serve -n n3 -p 8082 --daemon --peer localhost:8080 --peer localhost:8081 &
$ membrane cluster-status --port 8080`,
  },
];

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function highlight(src: string, isShell: boolean): string {
  if (isShell) {
    return escapeHtml(src)
      .split('\n')
      .map((line) =>
        line.startsWith('#')
          ? `<span class="text-ink-400">${line}</span>`
          : line
              .replace(/^(\$)/, '<span class="text-accent-mint">$1</span>')
              .replace(/(\s)(--?[a-z][a-z-]*)/g, '$1<span class="text-accent-cyan">$2</span>')
      )
      .join('\n');
  }
  return escapeHtml(src)
    .replace(/(&quot;[^&]*?&quot;)/g, '<span class="text-accent-mint">$1</span>')
    .replace(/\b(from|import|for|in|print)\b/g, '<span class="text-accent-violet">$1</span>')
    .replace(/\b(MembraneClient)\b/g, '<span class="text-accent-cyan">$1</span>');
}
---

<section id="code" class="relative py-24 sm:py-32 lg:py-40">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-[400px] w-[800px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-cyan/[0.06] blur-[120px]"></div>
  </div>

  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <span data-reveal class="eyebrow">Developer experience</span>
      <h2
        data-reveal
        data-reveal-delay="1"
        class="mt-4 text-balance font-display text-display-lg font-semibold tracking-tighter text-white"
      >
        From <span class="gradient-text-static">git clone</span> to a running node in minutes.
      </h2>
      <p
        data-reveal
        data-reveal-delay="2"
        class="mx-auto mt-5 max-w-xl text-pretty text-[1.0625rem] leading-relaxed text-ink-200"
      >
        One CLI for serving, clients, and admin; a typed Python client; an
        OpenAPI surface; and a container image that refuses to run insecurely.
      </p>
    </div>

    <div data-reveal data-reveal-delay="3" class="relative mx-auto mt-16 max-w-5xl">
      <div class="glass relative overflow-hidden rounded-[24px]">
        <div role="tablist" aria-label="Code examples" class="flex items-center gap-1 overflow-x-auto border-b border-white/[0.06] bg-ink-950/40 px-3 py-2" data-tabs>
          {
            snippets.map((s, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${s.id}`}
                aria-controls={`panel-${s.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-tab={s.id}
                class={`group inline-flex shrink-0 items-center gap-2 rounded-lg px-3 py-1.5 text-[0.82rem] font-medium transition-all duration-200 ${
                  i === 0 ? 'bg-white/[0.06] text-white' : 'text-ink-300 hover:bg-white/[0.04] hover:text-ink-100'
                }`}
              >
                <span class={`h-1.5 w-1.5 rounded-full ${i === 0 ? 'bg-accent-violet' : 'bg-ink-400 group-hover:bg-ink-200'}`} />
                <span class="code-block">{s.label}</span>
              </button>
            ))
          }
          <div class="ml-auto flex items-center gap-2 pr-2">
            <button type="button" data-copy class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-[0.72rem] font-medium text-ink-300 transition-colors hover:bg-white/[0.05] hover:text-white" aria-label="Copy code">
              <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5" y="5" width="9" height="9" rx="1.5" />
                <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" />
              </svg>
              <span data-copy-label>copy</span>
            </button>
          </div>
        </div>

        <div class="relative">
          {
            snippets.map((s, i) => (
              <pre
                role="tabpanel"
                id={`panel-${s.id}`}
                aria-labelledby={`tab-${s.id}`}
                data-panel={s.id}
                class={`code-block overflow-x-auto px-6 py-7 text-[0.85rem] leading-[1.7] ${i === 0 ? '' : 'hidden'}`}
              ><code set:html={highlight(s.code, s.shell)} /></pre>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        tabs.forEach((t) => {
          const active = t === tab;
          t.setAttribute('aria-selected', active ? 'true' : 'false');
          t.classList.toggle('bg-white/[0.06]', active);
          t.classList.toggle('text-white', active);
          t.classList.toggle('text-ink-300', !active);
          const dot = t.querySelector('span');
          if (dot) {
            dot.classList.toggle('bg-accent-violet', active);
            dot.classList.toggle('bg-ink-400', !active);
          }
        });
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.dataset.panel !== target);
        });
      });
    });
  }

  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const copyLabel = document.querySelector<HTMLElement>('[data-copy-label]');
  if (copyBtn && copyLabel) {
    copyBtn.addEventListener('click', async () => {
      const panel = document.querySelector<HTMLElement>('[data-panel]:not(.hidden)');
      if (!panel) return;
      // Copy runnable commands: drop the "$ " prompts.
      const text = panel.innerText.replace(/^\$ /gm, '');
      try {
        await navigator.clipboard.writeText(text);
        const prev = copyLabel.textContent;
        copyLabel.textContent = 'copied';
        setTimeout(() => (copyLabel.textContent = prev), 1400);
      } catch {
        copyLabel.textContent = 'select & copy';
      }
    });
  }
</script>
