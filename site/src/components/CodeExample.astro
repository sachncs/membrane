---
// Every snippet here is copied from docs/getting-started.md and is run
// as part of the test suite or the CI container smoke test.
import { INSTALL_COMMANDS } from '../lib/site';

const snippets = [
  {
    id: 'install',
    label: 'install',
    shell: true,
    code: INSTALL_COMMANDS,
  },
  {
    id: 'run',
    label: 'first run',
    shell: true,
    code: `$ membrane serve --daemon &
$ membrane client prefill --prompt-tokens "1 2 3 4 5 6 7 8"
$ membrane client inventory
$ membrane client retrieve --hash <payload_hash from inventory>`,
  },
  {
    id: 'python',
    label: 'python',
    shell: false,
    code: `import logging

from membrane.client import MembraneClient

logging.basicConfig(level=logging.INFO)
log = logging.getLogger("quickstart")

client = MembraneClient("http://localhost:8080")
result = client.prefill(list(range(256)), model_id="llama-3")
for frag in result["fragments"]:
    content_hash = frag["identity"]["payload_hash"]
    log.info("%s found=%s", content_hash, client.retrieve(content_hash)["found"])
client.close()`,
  },
  {
    id: 'secure',
    label: 'secure node',
    shell: true,
    code: `# Any non-loopback bind requires authentication.
# Keys are stored hashed; line 1 is the key, line 2 the keyfile entry.
$ membrane keys generate --subject ops --scope admin > ops.txt
$ sed -n 2p ops.txt > api-keys && chmod 600 api-keys
$ membrane serve --host 0.0.0.0 --api-key-file api-keys --daemon

# Or as a container (Python 3.14, read-only root, non-root user):
$ docker build -t membrane .
$ docker run --read-only --tmpfs /tmp -p 8080:8080 \\
    -v "$PWD/api-keys:/run/secrets/api-keys:ro" \\
    -e MEMBRANE_API_KEY_FILE=/run/secrets/api-keys membrane`,
  },
  {
    id: 'cluster',
    label: 'cluster',
    shell: true,
    code: `# Three local nodes; each seeds from the other two.
$ membrane serve -n n1 -p 8080 --daemon --peer localhost:8081 --peer localhost:8082 &
$ membrane serve -n n2 -p 8081 --daemon --peer localhost:8080 --peer localhost:8082 &
$ membrane serve -n n3 -p 8082 --daemon --peer localhost:8080 --peer localhost:8081 &
$ membrane cluster-status --port 8080`,
  },
];

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function highlight(src: string, isShell: boolean): string {
  if (isShell) {
    return escapeHtml(src)
      .split('\n')
      .map((line) =>
        line.startsWith('#')
          ? `<span class="text-ink-500">${line}</span>`
          : line
              .replace(/^(\$)/, '<span class="text-brand-400">$1</span>')
              .replace(/(\s)(--?[a-z][a-z-]*)/g, '$1<span class="text-signal-sky">$2</span>')
      )
      .join('\n');
  }
  return escapeHtml(src)
    .replace(/(&quot;[^&]*?&quot;)/g, '<span class="text-brand-300">$1</span>')
    .replace(/\b(from|import|for|in)\b/g, '<span class="text-signal-rose">$1</span>')
    .replace(/\b(MembraneClient)\b/g, '<span class="text-signal-sky">$1</span>');
}

const points = [
  { title: 'One CLI', body: 'Serve, query, inspect, evict, and repair from the same `membrane` command.' },
  { title: 'Typed Python client', body: 'Sync and async clients, plus an OpenAPI 3 schema for every route.' },
  { title: 'Secure container', body: 'Python 3.14, non-root, read-only root filesystem, drains on SIGTERM.' },
];
---

<section id="code" class="section">
  <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
    <div class="min-w-0">
      <p class="eyebrow">Developer experience</p>
      <h2 class="h-section mt-3">From git clone to a running node in minutes.</h2>
      <p class="lede mt-4">Every snippet here is copied from the quickstart and runs in CI.</p>
      <ul class="mt-8 space-y-5">
        {
          points.map((p) => (
            <li class="flex gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400" />
              <div>
                <div class="text-[0.9375rem] font-medium text-white">{p.title}</div>
                <div class="mt-0.5 text-[0.9375rem] text-ink-300" set:html={p.body.replace(/`([^`]+)`/g, '<code class="rounded bg-white/[0.06] px-1 py-0.5 font-mono text-[0.85em] text-ink-100">$1</code>')} />
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="window min-w-0 self-start">
      <div role="tablist" aria-label="Code examples" class="flex items-center gap-1 overflow-x-auto border-b border-white/[0.06] bg-white/[0.02] px-2 py-1.5" data-tabs>
        {
          snippets.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${s.id}`}
              aria-controls={`panel-${s.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-tab={s.id}
              class={`shrink-0 rounded-md px-3 py-1.5 font-mono text-[0.78rem] transition-colors ${
                i === 0 ? 'bg-white/[0.07] text-white' : 'text-ink-400 hover:text-ink-100'
              }`}
            >
              {s.label}
            </button>
          ))
        }
        <button type="button" data-copy class="ml-auto inline-flex shrink-0 items-center gap-1.5 rounded-md px-2 py-1 text-[0.75rem] text-ink-400 transition-colors hover:text-white" aria-label="Copy code">
          <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="5" y="5" width="9" height="9" rx="1.5" />
            <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" />
          </svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>
      <div class="min-h-[13rem]">
        {
          snippets.map((s, i) => (
            <pre
              role="tabpanel"
              id={`panel-${s.id}`}
              aria-labelledby={`tab-${s.id}`}
              data-panel={s.id}
              class={`code-block overflow-x-auto px-5 py-5 text-[0.8125rem] leading-[1.75] text-ink-200 ${i === 0 ? '' : 'hidden'}`}
            ><code set:html={highlight(s.code, s.shell)} /></pre>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        tabs.forEach((t) => {
          const active = t === tab;
          t.setAttribute('aria-selected', active ? 'true' : 'false');
          t.classList.toggle('bg-white/[0.07]', active);
          t.classList.toggle('text-white', active);
          t.classList.toggle('text-ink-400', !active);
        });
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.dataset.panel !== target);
        });
      });
    });
  }

  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const copyLabel = document.querySelector<HTMLElement>('[data-copy-label]');
  if (copyBtn && copyLabel) {
    copyBtn.addEventListener('click', async () => {
      const panel = document.querySelector<HTMLElement>('[data-panel]:not(.hidden)');
      if (!panel) return;
      // Copy runnable commands: drop the "$ " prompts.
      const text = panel.innerText.replace(/^\$ /gm, '');
      try {
        await navigator.clipboard.writeText(text);
        const prev = copyLabel.textContent;
        copyLabel.textContent = 'Copied';
        setTimeout(() => (copyLabel.textContent = prev), 1400);
      } catch {
        copyLabel.textContent = 'Select & copy';
      }
    });
  }
</script>
