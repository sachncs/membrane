---
import Logo from './Logo.astro';
import { REPO_URL, withBase } from '../lib/site';

const links = [
  { label: 'How it works', href: withBase('/#how-it-works') },
  { label: 'Features', href: withBase('/#features') },
  { label: 'Performance', href: withBase('/#performance') },
  { label: 'Docs', href: withBase('/docs/getting-started/') },
];
---

<header id="nav" class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-200" data-nav>
  <div class="container-page flex h-16 items-center justify-between">
    <a href={withBase('/')} aria-label="Membrane home"><Logo /></a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {links.map((l) => <a href={l.href} class="nav-link">{l.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      <a href={REPO_URL} target="_blank" rel="noreferrer noopener" class="btn-ghost hidden sm:inline-flex" aria-label="GitHub repository">
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
        <span>GitHub</span>
      </a>
      <a href={withBase('/docs/getting-started/')} class="btn-primary btn-sm">Get started</a>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('nav');
  if (nav) {
    const onScroll = () => {
      const scrolled = window.scrollY > 8;
      nav.classList.toggle('border-white/[0.07]', scrolled);
      nav.classList.toggle('bg-ink-950/80', scrolled);
      nav.classList.toggle('backdrop-blur-lg', scrolled);
      nav.classList.toggle('border-transparent', !scrolled);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
