# syntax=docker/dockerfile:1
# Membrane runtime image on free-threaded Python 3.14 (python3.14t, PEP 703).
#
# Same layout as ./Dockerfile, but the interpreter is uv's managed
# free-threaded CPython, so one node serves requests on several cores
# (MEMBRANE_HTTP_THREADS event loops, one per thread, sharing the node).
# grpcio would turn the GIL back on, so this image serves the /disagg
# REST routes and not --grpc-port.
#
#   docker build -f Dockerfile.ft -t membrane:ft .
#
# Base images are pinned by digest; Dependabot proposes bumps.
ARG BASE_IMAGE=debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.21@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711

FROM ${UV_IMAGE} AS uv


FROM ${BASE_IMAGE} AS builder

COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PYTHON_PREFERENCE=only-managed \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN --mount=type=cache,target=/root/.cache/uv uv python install 3.14t

WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --python 3.14t --extra server --no-install-project
COPY README.md LICENSE ./
COPY membrane/ membrane/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --python 3.14t --extra server --no-editable --reinstall-package membrane
# Fail the build if an installed extension would re-enable the GIL.
RUN /opt/venv/bin/python -c "import membrane.server, membrane.runtime.settings, sys; \
assert not sys._is_gil_enabled(), 'the server stack re-enabled the GIL'"


FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="Membrane (free-threaded)" \
      org.opencontainers.image.description="Global Contextual Memory Fabric for LLM inference, on python3.14t" \
      org.opencontainers.image.source="https://github.com/sachncs/membrane" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH \
    MEMBRANE_HOST=0.0.0.0 \
    MEMBRANE_PORT=8080 \
    MEMBRANE_DAEMON=true \
    MEMBRANE_LOG_FORMAT=json \
    MEMBRANE_HTTP_THREADS=4

RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends tini ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN groupadd -r --gid 1000 membrane \
 && useradd  -r --uid 1000 --gid 1000 --home-dir /app --shell /usr/sbin/nologin membrane \
 && install -d -o membrane -g membrane -m 0750 /var/lib/membrane

# The virtualenv's interpreter links into /opt/python: keep both paths.
COPY --from=builder /opt/python /opt/python
COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
USER membrane

EXPOSE 8080
VOLUME ["/var/lib/membrane"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-m", "membrane.healthcheck"]

STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["membrane", "serve"]
