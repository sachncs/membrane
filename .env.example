# Membrane environment configuration for `membrane serve`.
# Copy to .env and adjust. `membrane serve --help` lists every option.

MEMBRANE_NODE_ID=membrane-0
MEMBRANE_HOST=127.0.0.1
MEMBRANE_PORT=8080
MEMBRANE_LOG_LEVEL=INFO
# text, or json for one object per line
MEMBRANE_LOG_FORMAT=text

# Compute plugin: cpu, gpu, ollama, openai, anthropic, transformers, or an
# installed plugin (docs/plugins.md)
MEMBRANE_COMPUTE=cpu
# MEMBRANE_LLM_URL=http://localhost:11434
# MEMBRANE_LLM_MODEL=llama3.2
# MEMBRANE_LLM_API_KEY=

# Redis persistence; format redis://[:password@]host[:port][/db]
# MEMBRANE_REDIS_URL=redis://localhost:6379/0

# Authentication. Required when MEMBRANE_HOST is not a loopback address.
# Keyfile lines are "sha256:<digest>:<subject>:<scope,...>" (membrane keys
# generate); the file must not be readable by other users (chmod 600).
# MEMBRANE_API_KEY_FILE=/etc/membrane/api-keys
# mTLS instead of (or in addition to) API keys:
# MEMBRANE_TLS_CERT_FILE=/etc/membrane/tls/node.crt
# MEMBRANE_TLS_KEY_FILE=/etc/membrane/tls/node.key
# MEMBRANE_TLS_CA_FILE=/etc/membrane/tls/ca.crt
# MEMBRANE_TLS_ALLOWED_CNS=admin-membrane-0,admin-membrane-1

# Cluster
# MEMBRANE_PEERS=membrane-1:8080,membrane-2:8080
# MEMBRANE_ADVERTISE_HOST=membrane-0
# MEMBRANE_PEER_NETWORKS=10.0.0.0/8
# MEMBRANE_PEER_API_KEY_FILE=/etc/membrane/peer-api-key
# MEMBRANE_QUORUM_COUNT=2

# Capacity and shutdown
# MEMBRANE_MAX_CONCURRENCY=64
# MEMBRANE_RATE_LIMIT=0
# MEMBRANE_DRAIN_TIMEOUT=30
